PORT=3210
HOST=0.0.0.0
# Set to your HTTPS address in production. Used for share links.
PUBLIC_URL=
# Docker/Caddy deployment only: a domain pointing to your VM, without https://.
DOMAIN=
# Optional: prompt-to-scene. Keep the key on this server only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: Tiger Data/Postgres telemetry. Local JSONL is always written.
# For hosted databases use sslmode=verify-full and a trusted certificate; see SETUP.md.
DATABASE_URL=
# Mount a persistent volume here when deploying.
DATA_DIR=./data
