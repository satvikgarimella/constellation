{
  "name": "constellation-render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An opt-in browser render farm with WebGPU, live scheduling, and measurable contributions.",
  "engines": { "node": ">=22.9" },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "share": "node --env-file-if-exists=.env scripts/share.mjs",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser.mjs",
    "test:webgpu": "node test/webgpu.mjs",
    "test:scenes": "node test/scenes.mjs",
    "test:cad": "node test/cad-browser.mjs",
    "test:demo": "node test/demo.mjs",
    "test:controls": "node test/controls.mjs",
    "test:batching": "node test/batching.mjs",
    "test:network": "node test/network-batching.mjs",
    "test:load": "node test/load.mjs",
    "test:services-live": "node test/services-live.mjs",
    "test:database-live": "node test/services-database-live.mjs",
    "test:phones": "node scripts/phone-test.mjs",
    "verify:services": "node --env-file-if-exists=.env scripts/verify-services.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "check": "node --check server/index.js && node --check server/coordinator.js && node --check public/app.js && node --check public/render-worker.js"
  },
  "dependencies": {
    "occt-import-js": "0.0.23",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  }
}
